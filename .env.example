# ==========================================
# Puppy Pathfinder Quiz - Environment Variables
# ==========================================
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file to git.
#
# For Vite, all env vars must be prefixed with VITE_
# to be available in the client-side code.

# Backend API URL
# Local development: http://localhost:3000
# Staging: https://your-staging-railway-url.railway.app
# Production: https://api.ezwhelp.com
VITE_API_URL=http://localhost:3000

# Optional: Error tracking (post-launch)
# VITE_SENTRY_DSN=your_sentry_dsn_here

# Optional: Analytics (post-launch)
# VITE_POSTHOG_KEY=your_posthog_key_here
# VITE_PLAUSIBLE_DOMAIN=quiz.ezwhelp.com

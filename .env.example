# ==========================================
# Puppy Pathfinder Quiz - Environment Variables
# ==========================================
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file to git.
#
# For Vite, all env vars must be prefixed with VITE_
# to be available in the client-side code.

# Backend API URL
# Local development: http://localhost:3000
# Staging: https://your-staging-railway-url.railway.app
# Production: https://api.ezwhelp.com
VITE_API_URL=http://localhost:3000

# Server-side only: enables quiz email follow-up and event delivery.
# Never prefix these secrets with VITE_. Product prices need no API key.
KLAVIYO_PRIVATE_API_KEY=
KLAVIYO_LIST_ID=
# Quiz Leads list above; Master Marketing below. Both required to sync profiles.
KLAVIYO_MASTER_LIST_ID=
# Optional Facility Scale sales list (program_qty >= 3)
KLAVIYO_FACILITY_LIST_ID=
# Persistent server disk; never place this in public/ or dist/.
QUIZ_DB_PATH=data/quiz.sqlite
# Optional read_customers access for previous-purchase lookup.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Optional: Error tracking (post-launch)
# VITE_SENTRY_DSN=your_sentry_dsn_here

# Optional: Analytics (post-launch)
# VITE_POSTHOG_KEY=your_posthog_key_here
# VITE_PLAUSIBLE_DOMAIN=quiz.ezwhelp.com
